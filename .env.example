# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Client Configuration for Vite & Vercel
# Firebase 콘솔 (프로젝트 설정 > 일반 > 내 앱) 에서 발급받은 웹 앱 설정값을 입력하세요.
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-app-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
# (선택) 특정 Firestore Database ID를 사용할 경우 (기본값: (default))
VITE_FIREBASE_DATABASE_ID="(default)"
